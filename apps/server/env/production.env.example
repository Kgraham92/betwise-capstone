NODE_ENV=production
PORT=3001

JWT_SECRET=replace_with_production_secret
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=betwise_prod

CORS_ORIGIN=https://your-client-domain.example

ODDS_API_KEY=replace_with_production_key
ODDS_API_BASE_URL=https://api.the-odds-api.com
ODDS_MAX_REQUESTS_PER_SPORT_PER_24H=3

ENABLE_NBA=true
ENABLE_NFL=false
ENABLE_NHL=true
ENABLE_MLB=false
